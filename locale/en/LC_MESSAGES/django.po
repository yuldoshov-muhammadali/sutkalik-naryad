msgstr[0] "manually assigned %(n)s time, pool average %(mean)s"
msgstr[1] "manually assigned %(n)s times, pool average %(mean)s"

msgid ""
"Qoida: kamida 2 marta va hovuz (guruh o‘g‘illari yoki qizlar) o‘rtachasidan "
"kamida 2 baravar ko‘p."
msgstr ""
"Rule: at least 2 times and at least twice the pool average (group's male "
"cadets or female cadets)."

