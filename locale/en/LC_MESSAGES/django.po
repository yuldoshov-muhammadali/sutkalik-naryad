#, python-format
msgid ""
"Boshlang‘ich taqsimotda 6 ta joyning har biri bir martadan bo‘lishi kerak "
"(hozir %(n)d ta)."
msgid_plural ""
"Boshlang‘ich taqsimotda 6 ta joyning har biri bir martadan bo‘lishi kerak "
"(hozir %(n)d ta)."
msgstr[0] ""
"The initial distribution must contain each of the 6 posts exactly once "
"(currently %(n)d)."
msgstr[1] ""
"The initial distribution must contain each of the 6 posts exactly once "
"(currently %(n)d)."

msgid ""
"Boshlang‘ich guruh → joy taqsimoti (faqat bazada tasdiqlangan tarix "
"bo‘lmaganda, birinchi sutka uchun ishlatiladi)"
msgstr ""
"Initial group → post distribution (used for the first duty day only when the "
