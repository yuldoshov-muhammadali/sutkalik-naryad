msgstr "Other (comment required)"

msgid "Sabab tanlanmagan."
msgstr "No reason selected."

#, python-format
msgid "%(post)s: %(n)s ta o‘rin bo‘sh — almashtirish orqali kursant qo‘ying."
msgid_plural ""
"%(post)s: %(n)s ta o‘rin bo‘sh — almashtirish orqali kursant qo‘ying."
msgstr[0] "%(post)s: %(n)s slot is empty — assign a cadet using Replace."
msgstr[1] "%(post)s: %(n)s slots are empty — assign cadets using Replace."

#, python-format
msgid "%(name)s (%(slot)s) faol emas — almashtiring yoki qayta tuzing."
msgstr "%(name)s (%(slot)s) is inactive — replace or regenerate."

#, python-format
msgid ""
"%(name)s (%(slot)s) — %(position)s, naryadga chiqmaydi — almashtiring yoki "
"qayta tuzing."
msgstr ""
"%(name)s (%(slot)s) — %(position)s, not on the duty roster — replace or "
"regenerate."

#, python-format
msgid ""
"%(name)s zalyoti bekor qilingan — jazo o‘rnini almashtiring yoki qayta "
"tuzing."
msgstr ""
"%(name)s's penalty has been cancelled — replace them on the extra-duty slot "
"or regenerate."

#, python-format
msgid ""
"%(name)s (%(slot)s) kasallar ro‘yxatida (%(start)s–%(end)s) — “Almashtirish” "
"bilan boshqa kursant qo‘ying."
msgstr ""
"%(name)s (%(slot)s) is on the sick list (%(start)s–%(end)s) — put another "
"cadet via “Replace”."

#, python-format
msgid ""
"%(name)s (%(slot)s) — %(reason)s (%(start)s–%(end)s). Almashtiring yoki "
"qayta tuzing."
msgstr ""
"%(name)s (%(slot)s) — %(reason)s (%(start)s–%(end)s). Replace or regenerate."

#, python-format
msgid ""
"Zalyotchik %(name)s bugun guruhi bilan oddiy navbatda turibdi (jazo hisobiga "
"o‘tmaydi)."
msgstr ""
"Offender %(name)s is on regular duty with their group today (does not count "
"as extra duty)."

#, python-format
msgid ""
"Zalyotchik %(name)s faol emas yoki naryadga chiqmaydi (lavozimda) — bugun "
"qo‘yilmadi."
msgstr ""
"Offender %(name)s is inactive or not on the duty roster (position) — not "
"assigned today."

#, python-format
msgid "Zalyotchik %(name)s sababli holatda bo‘lgani uchun bugun qo‘yilmadi."
msgstr "Offender %(name)s was not assigned today: excused absence."

#, python-format
msgid "Zalyotchik %(name)s kecha turgani uchun bugun qo‘yilmadi."
msgstr ""
"Offender %(name)s was not assigned today because they were on duty yesterday."

#, python-format
msgid "Zalyotchik %(name)s: bugun jazo o‘rni qolmadi — keyingi sutkaga qoldi."
msgstr ""
"Offender %(name)s: no extra-duty slot left today — carried over to the next "
"duty day."

msgid "Bu sana ochilgan 2-kurs haftasiga tegishli emas."
msgstr "This date does not belong to an open 2nd-year week."

msgid ""
"Tarix ham, boshlang‘ich guruh → joy taqsimoti ham yo‘q — birinchi sutkani "
"tuzib bo‘lmaydi. Sozlamalarda boshlang‘ich taqsimotni kiriting."
msgstr ""
"There is neither history nor an initial group → post distribution — the "
"first duty day cannot be generated. Enter the initial distribution in "
"Settings."

#, python-format
msgid "Kasal: %(start)s–%(end)s (kasallar ro‘yxatida)."
msgstr "Sick: %(start)s–%(end)s (on the sick list)."

#, python-format
msgid "%(position)s — naryadga chiqmaydi"
msgstr "%(position)s — not on the duty roster"

msgid "Bu kursant allaqachon shu o‘rinda."
msgstr "This cadet is already in this slot."

#, python-format
msgid "%(name)s faol emas (%(reason)s)."
msgstr "%(name)s is inactive (%(reason)s)."

#, python-format
msgid "%(name)s — %(position)s, sutkalik naryadga qo‘yilmaydi."
msgstr "%(name)s — %(position)s, cannot be assigned to the daily duty."

msgid "O‘g‘il bolani Qizlar yotoqxonasiga qo‘yib bo‘lmaydi."
msgstr "A male cadet cannot be assigned to the Female dormitory."

msgid ""
"Qizlar faqat Qizlar yotoqxonasida turadi — o‘g‘il bolalar o‘rniga qo‘yib "
"bo‘lmaydi."
msgstr ""
"Female cadets serve only in the Female dormitory — they cannot be assigned "
"to male slots."

#, python-format
msgid ""
"%(name)s faol zalyotchik — oddiy navbatda faqat 1-NO‘J yoki 1-Yotoqxonada "
"(o‘z guruhi bilan) turadi, boshqa joylarga qo‘yilmaydi."
msgstr ""
"%(name)s is an active offender: on regular duty they serve only at "
"Checkpoint 1 or Dormitory 1 (with their group) and are not assigned to other "
"posts."

#, python-format
msgid ""
"%(post)s bu sutkada %(group)s guruhiga tegishli — boshqa guruhdan "
"(%(other)s) kursant qo‘yib bo‘lmaydi."
msgstr ""
"On this duty day %(post)s belongs to group %(group)s — a cadet from another "
"group (%(other)s) cannot be assigned."

#, python-format
msgid "%(name)s shu sutkada boshqa o‘rinda turibdi: %(slot)s."
msgstr "%(name)s is already in another slot on this duty day: %(slot)s."

#, python-format
msgid ""
"%(name)s kecha (%(day)s) naryadda bo‘lgan — ketma-ket ikki sutka turmaydi."
msgstr "%(name)s was on duty yesterday (%(day)s) — no two duty days in a row."

#, python-format
msgid "%(name)s sababli yo‘q: %(reason)s (%(start)s–%(end)s)."
msgstr ""
"%(name)s is absent for an excused reason: %(reason)s (%(start)s–%(end)s)."

msgid "Bu sutka hali tuzilmagan yoki o‘chirilgan — sahifani yangilang."
msgstr ""
"This duty day has not been generated yet or was deleted — refresh the page."

msgid ""
"Sutka tasdiqlangan — o‘zgartirib bo‘lmaydi. Kerak bo‘lsa, admin tasdiqni "
"bekor qiladi."
msgstr ""
"The duty day is approved and cannot be changed. If necessary, the admin can "
"revoke the approval."

msgid "Ikki xil qatorni tanlang."
msgstr "Select two different rows."

msgid "Ikkala qatorda ham kursant bo‘lishi kerak."
msgstr "Both rows must have a cadet."

msgid "O‘zaro almashtirish faqat bitta joy ichida mumkin."
msgstr "Swapping is only possible within the same post."

msgid "Ikkala qatorda lavozim bir xil — almashtirishning ma’nosi yo‘q."
msgstr "Both rows have the same role — swapping makes no sense."

msgid ""
"Jazo naryadidagi zalyotchik faqat posbon bo‘ladi — uning lavozimini "
"almashtirib bo‘lmaydi."
msgstr ""
"An offender on extra duty can only be an orderly — their role cannot be "
"swapped."

#, python-format
msgid "Tasdiqlab bo‘lmaydi: %(issues)s"
msgstr "Cannot approve: %(issues)s"

#, python-format
msgid ""
"Keyingi sutka (%(day)s) allaqachon tuzilgan — avval uni bekor qilish kerak."
msgstr ""
"The next duty day (%(day)s) has already been generated — revoke it first."

msgid "Sutka tasdiqlanmagan."
msgstr "The duty day is not approved."

msgid "Tasdiqni bekor qilish sababi majburiy."
msgstr "A reason for revoking the approval is required."

msgid "Tasdiqlangan sutkani o‘chirib bo‘lmaydi — avval tasdiqni bekor qiling."
msgstr "An approved duty day cannot be deleted — revoke the approval first."

#, python-format
msgid ""
"Faqat eng oxirgi qoralamani o‘chirish mumkin — keyin %(day)s sutkasi bor."
msgstr ""
"Only the latest draft can be deleted — the %(day)s duty day comes after it."

msgid "Qoralamani o‘chirish sababi majburiy."
msgstr "A reason for deleting the draft is required."

msgid "Fayl juda katta: ko‘pi bilan 8 MB."
msgstr "The file is too large: 8 MB at most."

msgid ""
"HEIC formati qo‘llab-quvvatlanmaydi. Telefonda kamerani “Eng mos” (JPG) "
"formatiga o‘tkazing yoki rasmni JPG qilib yuboring."
msgstr ""
"HEIC is not supported. Switch the phone camera to “Most Compatible” (JPG) or "
"send the photo as JPG."

msgid "Faqat rasm: JPG, PNG yoki WEBP."
msgstr "Images only: JPG, PNG or WEBP."

msgid "Rasm o‘lchami juda katta."
msgstr "The image dimensions are too large."

msgid "Rasm"
msgstr "Image"

msgid "Hujjat turi"
