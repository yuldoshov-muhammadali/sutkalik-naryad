msgid ""
"Sarlavha qatorida ustunlar yetishmaydi: %(missing)s. Kerakli: %(required)s."
msgstr ""
"The header row is missing columns: %(missing)s. Required: %(required)s."

#, python-format
msgid "Qatorlar juda ko‘p (%(count)s); ko‘pi bilan %(max)s ta."
msgstr "Too many rows (%(count)s); %(max)s at most."

