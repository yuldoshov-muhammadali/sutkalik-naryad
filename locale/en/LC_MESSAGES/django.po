msgid "Ko‘rib chiqish va tozalash →"
msgstr "Review and clear →"

msgid "hozir bloklangan"
msgstr "currently blocked"

msgid "boshqaruv paneli"
msgstr "admin panel"

msgid "Naryad ma’lumotlari"
msgstr "Duty data"

#, python-format
msgid ""
"Juda ko‘p noto‘g‘ri urinish (%(failures)s marta). Bu login %(minutes)s "
"daqiqaga bloklandi — taxminan %(left)s daqiqadan keyin qayta urinib ko‘ring."
msgid_plural ""
"Juda ko‘p noto‘g‘ri urinish (%(failures)s marta). Bu login %(minutes)s "
"daqiqaga bloklandi — taxminan %(left)s daqiqadan keyin qayta urinib ko‘ring."
msgstr[0] ""
"Too many failed attempts (%(failures)s). This login is blocked for "
"%(minutes)s minutes — try again in about %(left)s minutes."
msgstr[1] ""
"Too many failed attempts (%(failures)s). This login is blocked for "
"%(minutes)s minutes — try again in about %(left)s minutes."

msgid ""
"Login yoki parol noto‘g‘ri. Ikkalasida ham katta-kichik harf farqlanadi."
msgstr "Incorrect username or password. Both are case-sensitive."

msgid "Bu akkaunt faol emas."
msgstr "This account is inactive."

msgid "Login"
msgstr "Username"

msgid "Parol"
msgstr "Password"

msgid "Login yoki parol noto‘g‘ri yoki boshqaruv paneliga kirish huquqi yo‘q."
msgstr "Incorrect username or password, or no access to the admin panel."

msgid ""
"Xavfsizlik uchun avval vaqtinchalik parolni o‘zingizning parolingizga "
"almashtiring."
msgstr "For security, first replace your temporary password with your own."

msgid "Fayl .xlsx (Excel) formatida emas."
msgstr "The file is not in .xlsx (Excel) format."

msgid "Faylni o‘qib bo‘lmadi — .xlsx (Excel) formatida ekanini tekshiring."
msgstr "Could not read the file — make sure it is in .xlsx (Excel) format."

msgid "Fayl ichidagi ma’lumot juda katta."
msgstr "The data inside the file is too large."

msgid "Fayl juda katta (2 MB dan oshmasin)."
msgstr "The file is too large (2 MB maximum)."

