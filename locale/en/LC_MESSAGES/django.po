#, python-format
msgid "%(line)s-qator: bazadagi “%(name)s” faylda ikkinchi marta uchradi"
msgstr ""
"Row %(line)s: “%(name)s” from the database appears in the file a second time"

#, python-format
msgid "Jinsi: %(old)s → %(new)s"
msgstr "Gender: %(old)s → %(new)s"

