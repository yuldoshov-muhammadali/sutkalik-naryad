#, python-format
msgid ""
"%(group)s guruhida “%(name)s” allaqachon bor — bir xil F.I.Sh. ikki marta "
"kiritilmaydi."
msgstr ""
"“%(name)s” already exists in group %(group)s — the same full name cannot be "
"entered twice."

msgid "guruhi va jinsi"
msgstr "group and gender"

msgid "guruhi"
msgstr "group"

msgid "jinsi"
msgstr "gender"

#, python-format
msgid ""
"Bu kursantning naryad tarixi bor, siz %(fields)sni o‘zgartiryapsiz. Tarix "
"o‘chmaydi (eski naryadlar o‘sha paytdagi guruh bilan qoladi), o‘zgarish "
"faqat keyingi naryadlarga ta’sir qiladi. Davom etish uchun belgini qo‘ying."
msgstr ""
"This cadet has a duty history and you are changing their %(fields)s. The "
"history will not be deleted (past duties keep the group of that time); the "
"change only affects future duties. Tick the box to continue."

msgid "masalan: buyruq raqami"
msgstr "e.g. order number"

msgid "“Boshqa” sabab uchun izoh majburiy."
msgstr "A comment is required for the “Other” reason."

msgid "Lavozimi"
msgstr "Role"

msgid "masalan: BI-225 guruh komandiri"
msgstr "e.g. BI-225 group commander"

msgid "masalan: buyruq raqami va sanasi"
msgstr "e.g. order number and date"

msgid "masalan: lavozimdan bo‘shadi (buyruq)"
msgstr "e.g. relieved of position (order)"

#, python-format
msgid ""
"%(name)s faol zalyotchik (%(count)s ta jazo naryadi) — avval zalyot "
"bajarilishi yoki bekor qilinishi kerak, keyin “naryadga chiqmaydi” deb "
"belgilanadi."
msgstr ""
"%(name)s is an active offender (%(count)s extra duties): the penalty must "
"first be served or cancelled, then the cadet can be marked as “not on the "
"duty roster”."

msgid "Zaxira bo‘sh chiqdi."
msgstr "The backup turned out empty."

msgid "Zaxira fayli yozilmadi."
msgstr "The backup file was not written."

#, python-format
msgid "Zaxira olinmadi: %(error)s"
msgstr "Backup failed: %(error)s"

msgid "Tasdiqlash so‘zlari noto‘g‘ri — hech narsa o‘chirilmadi."
msgstr "The confirmation words are wrong — nothing was deleted."

msgid ""
"Ko‘rib chiqilgandan keyin ma’lumot o‘zgargan yoki allaqachon tozalangan — "
"qayta ko‘rib chiqing."
msgstr ""
"The data changed after the review or has already been cleared — review again."

msgid "O‘chiradigan sinov ma’lumoti yo‘q — allaqachon tozalangan."
msgstr "No test data to delete — already cleared."

