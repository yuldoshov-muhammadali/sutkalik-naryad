msgstr "Review and approve the %(day)s draft"

#, python-format
msgid "%(day)s sutkasi qoralamasini tuzish"
msgstr "Generate the draft for the %(day)s duty day"

msgid ""
"Tarix yo‘q va boshlang‘ich guruh → joy taqsimoti kiritilmagan — birinchi "
"sutkani tuzib bo‘lmaydi."
msgstr ""
"There is no history and no initial group → post distribution has been "
"entered — the first duty day cannot be generated."

msgid "Boshlang‘ich taqsimotni kiritish"
msgstr "Enter the initial distribution"

msgid "Bu haftaning barcha 7 sutkasi tuzilgan."
msgstr "All 7 duty days of this week have been generated."

msgid "Keyingi 2-kurs haftasini ochish"
msgstr "Open the next 2nd-year week"

