#, python-format
msgid "%(name)s (%(slot)s) faol emas — almashtiring yoki qayta tuzing."
msgstr "%(name)s (%(slot)s) неактивен — замените или пересформируйте."

#, python-format
msgid ""
"%(name)s (%(slot)s) — %(position)s (lavozimda) — almashtiring yoki qayta "
"tuzing."
msgstr ""
"%(name)s (%(slot)s) — %(position)s (на должности) — замените или "
"пересформируйте."

#, python-format
msgid ""
