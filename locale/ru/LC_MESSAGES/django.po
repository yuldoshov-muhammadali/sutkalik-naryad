msgstr "Группа"

msgid "Jinsi"
msgstr "Пол"

msgid "Qisqa ism"
msgstr "Краткое имя"

msgid "Chetlatilgan"
msgstr "Отчислен"

msgid "Akademik ta’til"
msgstr "Академический отпуск"

msgid "Boshqa kursga o‘tgan"
msgstr "Переведён на другой курс"

