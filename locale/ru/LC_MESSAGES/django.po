msgstr "Примечание"

msgid "— kursantni tanlang —"
msgstr "— выберите курсанта —"

msgid "Oxirgi sutka birinchisidan oldin bo‘lishi mumkin emas."
msgstr "Последние сутки не могут быть раньше первых."

#, python-format
msgid ""
"%(name)s uchun bu sanalarga allaqachon yozuv bor: %(reason)s "
"%(start)s–%(end)s. O‘sha yozuvning tugash sanasini o‘zgartiring."
msgstr ""
"Для %(name)s на эти даты уже есть запись: %(reason)s %(start)s–%(end)s. "
"Измените дату окончания этой записи."

msgid "Yangi tugash sanasi"
msgstr "Новая дата окончания"

msgid "Tugash sanasi boshlanish sanasidan oldin bo‘lishi mumkin emas."
msgstr "Дата окончания не может быть раньше даты начала."

msgid "Bu sanalarda shu kursantning boshqa yozuvi bor."
msgstr "На эти даты у этого курсанта уже есть другая запись."

msgid "Naryad platformasi"
msgstr "Платформа нарядов"

msgid "o‘g‘il"
msgstr "юноши"

msgid "qiz"
msgstr "девушки"

msgid "Faollik"
msgstr "Активность"

msgid "Naryaddan ozod"
msgstr "Освобождён от наряда"

msgid ""
"Kursant kartochkasidagi “Naryaddan ozod qilish” / “Naryadga qaytarish” "
"orqali o‘zgartiriladi."
msgstr ""
"Изменяется через “Освободить от наряда” / “Вернуть в наряд” в карточке "
"курсанта."

msgid "Tizim"
msgstr "Система"

msgid "F.I.Sh."
msgstr "ФИО"

msgid "o‘rinlar"
msgstr "места"

msgid "sutkalar"
msgstr "сутки"

msgid "tasdiqlangan"
msgstr "утверждено"

msgid "ogohlantirish"
msgstr "предупреждение"

#, python-format
msgid ""
"Boshlang‘ich taqsimotda 6 ta joyning har biri bir martadan bo‘lishi kerak "
"(hozir %(n)d ta)."
msgid_plural ""
"Boshlang‘ich taqsimotda 6 ta joyning har biri bir martadan bo‘lishi kerak "
"(hozir %(n)d ta)."
msgstr[0] ""
"В начальном распределении каждый из 6 постов должен встречаться ровно один "
"раз (сейчас %(n)d)."
msgstr[1] ""
"В начальном распределении каждый из 6 постов должен встречаться ровно один "
"раз (сейчас %(n)d)."
msgstr[2] ""
"В начальном распределении каждый из 6 постов должен встречаться ровно один "
"раз (сейчас %(n)d)."
msgstr[3] ""
"В начальном распределении каждый из 6 постов должен встречаться ровно один "
"раз (сейчас %(n)d)."

msgid ""
"Boshlang‘ich guruh → joy taqsimoti (faqat bazada tasdiqlangan tarix "
"bo‘lmaganda, birinchi sutka uchun ishlatiladi)"
msgstr ""
"Начальное распределение группа → пост (используется для первых суток, только"
" если в базе нет утверждённой истории)"

msgid "hozir bloklangan"
msgstr "сейчас заблокирован"

msgid "Sutkalik naryad — boshqaruv paneli"
msgstr "Суточный наряд — панель управления"

msgid "Sutkalik naryad"
msgstr "Суточный наряд"

msgid "2-kurs sutkalik naryadlari"
msgstr "Суточные наряды 2-го курса"

#, python-format
msgid ""
"Juda ko‘p noto‘g‘ri urinish (%(failures)s marta). Bu login %(minutes)s "
"daqiqaga bloklandi — taxminan %(left)s daqiqadan keyin qayta urinib ko‘ring."
msgid_plural ""
"Juda ko‘p noto‘g‘ri urinish (%(failures)s marta). Bu login %(minutes)s "
"daqiqaga bloklandi — taxminan %(left)s daqiqadan keyin qayta urinib ko‘ring."
msgstr[0] ""
"Слишком много неудачных попыток (%(failures)s раз). Этот логин заблокирован "
"на %(minutes)s мин — попробуйте снова примерно через %(left)s минуту."
msgstr[1] ""
"Слишком много неудачных попыток (%(failures)s раз). Этот логин заблокирован "
"на %(minutes)s мин — попробуйте снова примерно через %(left)s минуты."
msgstr[2] ""
"Слишком много неудачных попыток (%(failures)s раз). Этот логин заблокирован "
"на %(minutes)s мин — попробуйте снова примерно через %(left)s минут."
msgstr[3] ""
"Слишком много неудачных попыток (%(failures)s раз). Этот логин заблокирован "
"на %(minutes)s мин — попробуйте снова примерно через %(left)s минут."

msgid ""
"Login yoki parol noto‘g‘ri. Ikkalasida ham katta-kichik harf farqlanadi."
msgstr "Неверный логин или пароль. В обоих учитывается регистр букв."

msgid "Bu akkaunt faol emas."
msgstr "Эта учётная запись неактивна."

msgid "Login"
msgstr "Логин"

msgid "Parol"
msgstr "Пароль"

msgid "Login yoki parol noto‘g‘ri yoki boshqaruv paneliga kirish huquqi yo‘q."
msgstr "Неверный логин или пароль либо нет доступа к панели управления."

msgid ""
"Xavfsizlik uchun avval vaqtinchalik parolni o‘zingizning parolingizga "
"almashtiring."
msgstr "В целях безопасности сначала замените временный пароль на свой."

msgid "Fayl .xlsx (Excel) formatida emas."
msgstr "Файл не в формате .xlsx (Excel)."

msgid "Faylni o‘qib bo‘lmadi — .xlsx (Excel) formatida ekanini tekshiring."
msgstr ""
"Не удалось прочитать файл — убедитесь, что он в формате .xlsx (Excel)."

msgid "Fayl ichidagi ma’lumot juda katta."
msgstr "Слишком большой объём данных в файле."

msgid "Fayl juda katta (2 MB dan oshmasin)."
msgstr "Файл слишком большой (не более 2 МБ)."

#, python-format
msgid "Qatorlar juda ko‘p; ko‘pi bilan %(max)s ta."
msgstr "Слишком много строк; не более %(max)s."

msgid "Fayl bo‘sh."
msgstr "Файл пуст."

#, python-format
msgid ""
"Sarlavha qatorida ustunlar yetishmaydi: %(missing)s. Kerakli: %(required)s."
msgstr ""
"В строке заголовков не хватает столбцов: %(missing)s. Требуются: "
"%(required)s."

#, python-format
msgid "Qatorlar juda ko‘p (%(count)s); ko‘pi bilan %(max)s ta."
msgstr "Слишком много строк (%(count)s); не более %(max)s."

msgid "familiya bo‘sh"
msgstr "фамилия не заполнена"

msgid "ism bo‘sh"
msgstr "имя не заполнено"

#, python-format
msgid "guruh topilmadi: «%(group)s»"
msgstr "группа не найдена: «%(group)s»"

msgid "guruh bo‘sh"
msgstr "группа не заполнена"

#, python-format
msgid "jins noto‘g‘ri: «%(gender)s» (o‘g‘il yoki qiz)"
msgstr "неверный пол: «%(gender)s» (ожидается «male» или «female»)"

#, python-format
msgid "fayl ichida takrorlangan (%(line)s-qator bilan bir xil)"
msgstr "повтор в файле (совпадает со строкой %(line)s)"

#, python-format
msgid "%(line)s-qator: %(problem)s"
msgstr "Строка %(line)s: %(problem)s"

#, python-format
msgid "Guruh: %(old)s → %(new)s"
msgstr "Группа: %(old)s → %(new)s"

#, python-format
msgid "Otasining ismi: %(old)s → %(new)s"
msgstr "Отчество: %(old)s → %(new)s"

#, python-format
msgid ""
"%(line)s-qator: «%(name)s» bir nechta guruhda bor — qaysi biri ekanini "
"aniqlab bo‘lmaydi"
msgstr ""
"Строка %(line)s: «%(name)s» есть в нескольких группах — невозможно "
"определить, в какой именно"

#, python-format
msgid "%(line)s-qator: bazadagi “%(name)s” faylda ikkinchi marta uchradi"
msgstr "Строка %(line)s: “%(name)s” из базы встречается в файле второй раз"

#, python-format
msgid "Jinsi: %(old)s → %(new)s"
msgstr "Пол: %(old)s → %(new)s"

msgid "Xatoli qatorlar bor — import tasdiqlanmaydi."
msgstr "Есть строки с ошибками — импорт не будет подтверждён."

msgid "Familiya"
msgstr "Фамилия"

msgid "Ism"
msgstr "Имя"

msgid "Otasining ismi"
msgstr "Отчество"

