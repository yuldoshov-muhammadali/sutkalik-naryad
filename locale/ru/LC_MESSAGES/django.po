#, python-format
msgid "%(post)s: %(n)s ta o‘rin bo‘sh — almashtirish orqali kursant qo‘ying."
msgid_plural ""
"%(post)s: %(n)s ta o‘rin bo‘sh — almashtirish orqali kursant qo‘ying."
msgstr[0] ""
"%(post)s: %(n)s место не заполнено — поставьте курсанта через замену."
msgstr[1] ""
