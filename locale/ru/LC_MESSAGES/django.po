msgid "“Shu haftada” — tanlangan 2-kurs haftasi."
msgstr "“На этой неделе” — выбранная неделя 2-го курса."

msgid "“Shu haftada” — joriy (oxirgi) 2-kurs haftasi."
msgstr "“На этой неделе” — текущая (последняя) неделя 2-го курса."

msgid "Guruh tanlanmagan."
msgstr "Группа не выбрана."

msgid "Qizlar (alohida hovuz)"
msgstr "Девушки (отдельный пул)"

msgid "Qizlar yo‘q."
msgstr "Девушек нет."

#, python-format
msgid "Ketma-ket ikki naryadda navbatchi bo‘lgan: %(n)s ta holat"
msgid_plural "Ketma-ket ikki naryadda navbatchi bo‘lgan: %(n)s ta holat"
msgstr[0] "Дежурный в двух нарядах подряд: %(n)s случай"
msgstr[1] "Дежурный в двух нарядах подряд: %(n)s случая"
msgstr[2] "Дежурный в двух нарядах подряд: %(n)s случаев"
msgstr[3] "Дежурный в двух нарядах подряд: %(n)s случаев"

#, python-format
msgid "%(first)s va %(second)s"
msgstr "%(first)s и %(second)s"

msgid "Ketma-ket ikki naryadda navbatchi bo‘lgan qiz yo‘q."
msgstr "Девушек, бывших дежурными в двух нарядах подряд, нет."

msgid "Guruhlar kesimi: guruh × joy (necha sutka bergan)"
msgstr "По группам: группа × пост (сколько суток выделила)"

msgid "Faol, lavozimdagilarsiz"
msgstr "Активные, без курсантов на должностях"

msgid "1 o‘g‘ilga o‘rtacha naryad"
msgstr "Нарядов в среднем на 1 юношу"

msgid ""
"Aylanish to‘g‘ri ishlasa, har guruh har joyni deyarli teng marta beradi. Joy "
"guruhga biriktiriladi, shuning uchun <b>kursanti kam guruhda bir o‘g‘ilga "
"ko‘proq naryad to‘g‘ri keladi</b> — bu qabul qilingan qoida (adolat guruh "
"ichida o‘lchanadi, CLAUDE.md 4-B.5)."
msgstr ""
"Если ротация работает правильно, каждая группа выделяет на каждый пост почти "
"одинаковое число раз. Пост закрепляется за группой, поэтому <b>в группе с "
"меньшим числом курсантов на одного юношу приходится больше нарядов</b> — это "
"принятое правило (справедливость измеряется внутри группы, CLAUDE.md 4-B.5)."

msgid ""
"O‘rtacha faqat naryadga chiqadigan o‘g‘il bolalar soniga bo‘linadi "
"(lavozimdagi komandirlar va kurs lavozimlari kirmaydi)."
msgstr ""
"Среднее делится только на число юношей, заступающих в наряд (командиры и "
"курсовые должности не входят)."

msgid "Qo‘lda tuzatishlar nazorati"
msgstr "Контроль ручных исправлений"

#, python-format
msgid ""
"Tasdiqlangan sutkalardagi almashtirishlar (sutka qayta tuzilganda yo‘qolgan "
"tuzatishlar sanalmaydi). Jami: <b>%(total)s</b>."
msgstr ""
"Замены в утверждённых сутках (исправления, потерянные при пересформировании "
"суток, не учитываются). Всего: <b>%(total)s</b>."

msgid "Diqqat: qo‘lda qo‘yilishi guruh o‘rtachasidan sezilarli ko‘p"
msgstr "Внимание: ручных назначений заметно больше среднего по группе"

#, python-format
msgid "qo‘lda %(n)s marta qo‘yilgan, hovuz o‘rtachasi %(mean)s"
msgid_plural "qo‘lda %(n)s marta qo‘yilgan, hovuz o‘rtachasi %(mean)s"
msgstr[0] "вручную назначен %(n)s раз, среднее по пулу %(mean)s"
msgstr[1] "вручную назначен %(n)s раза, среднее по пулу %(mean)s"
msgstr[2] "вручную назначен %(n)s раз, среднее по пулу %(mean)s"
msgstr[3] "вручную назначен %(n)s раз, среднее по пулу %(mean)s"

msgid ""
"Qoida: kamida 2 marta va hovuz (guruh o‘g‘illari yoki qizlar) o‘rtachasidan "
"kamida 2 baravar ko‘p."
msgstr ""
"Правило: не менее 2 раз и не менее чем в 2 раза больше среднего по пулу "
"(юноши группы или девушки)."

msgid "Sabablar bo‘yicha"
msgstr "По причинам"

msgid "Kim tomonidan"
msgstr "Кем"

msgid "Almashtirish yo‘q."
msgstr "Замен нет."

msgid "Qo‘lda qo‘yilgan"
msgstr "Назначен вручную"

msgid "Qo‘lda olingan"
msgstr "Снят вручную"

msgid "Hovuz o‘rtachasi"
msgstr "Среднее по пулу"

msgid "(qiz)"
msgstr "(девушка)"

msgid ""
"Agar sababli holatingiz bo‘lsa (kasallik, tadbirda qatnashish, sport "
"musobaqasi) va naryad hali tasdiqlanmagan bo‘lsa, kurs starshinasiga yoki "
"kurs boshlig‘iga uchrang."
msgstr ""
"Если у вас есть уважительная причина (болезнь, участие в мероприятии, "
"спортивные соревнования), а наряд ещё не утверждён, обратитесь к старшине "
"курса или начальнику курса."

msgid "Joriy sutka:"
msgstr "Текущие сутки:"

msgid "Joriy sutka o‘tgan qismi"
msgstr "Прошедшая часть текущих суток"

msgid "Bojxona instituti binosi"
msgstr "Здание Таможенного института"

msgid "Chiqish"
msgstr "Выйти"

msgid "Rejim: avtomatik (tizimga qarab)"
msgstr "Режим: автоматически (как в системе)"

msgid "Rejim: kunduzgi"
msgstr "Режим: дневной"

msgid "Rejim: tungi"
msgstr "Режим: ночной"

msgid "Kunduzgi / tungi rejim"
msgstr "Дневной / ночной режим"

msgid "Kirish"
msgstr "Войти"

msgid "Tizimga kirish"
msgstr "Вход в систему"

msgid "Login va parolni kurs boshlig‘idan olasiz."
msgstr "Логин и пароль выдаёт начальник курса."

msgid "5 marta noto‘g‘ri urinishdan keyin login 15 daqiqaga bloklanadi."
msgstr "После 5 неверных попыток логин блокируется на 15 минут."

msgid "Parolni almashtirish"
msgstr "Смена пароля"

msgid ""
"Sizga vaqtinchalik parol berilgan. Davom etish uchun o‘zingizning "
"parolingizni o‘rnating."
msgstr "Вам выдан временный пароль. Чтобы продолжить, установите свой пароль."

msgid "Parolni saqlash"
msgstr "Сохранить пароль"
