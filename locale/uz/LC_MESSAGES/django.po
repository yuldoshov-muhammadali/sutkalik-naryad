msgstr ""
"\"%(value)s\" qiymati to‘g‘ri formatga (YYYY-MM-DD) ega, ammo bu noto‘g‘ri "
"sana."

#, python-format
msgid ""
"“%(value)s” value has an invalid format. It must be in YYYY-MM-DD "
