# Production .env namunasi: cp .env.prod.example .env  va qiymatlarni to'ldiring.
# docs/joylashtirish.md ga qarang.

# --- Domen ---
# A variant (VPS + domen): DOMAIN=naryad.example.uz
# B variant (internetsiz ichki tarmoq): DOMAIN=:80  va  DJANGO_HTTPS=False
DOMAIN=naryad.example.uz

# --- Django ---
# Uzun tasodifiy kalit: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Vergul bilan: domen (B variantda — serverning ichki IP manzili, masalan 192.168.1.10)
DJANGO_ALLOWED_HOSTS=naryad.example.uz
# HTTPS manzil (B variantda: http://192.168.1.10)
DJANGO_CSRF_TRUSTED_ORIGINS=https://naryad.example.uz
# HTTPS bor (A variant) — True; internetsiz ichki tarmoq (B variant) — False
DJANGO_HTTPS=True
GUNICORN_WORKERS=3

# --- PostgreSQL ---
POSTGRES_DB=naryad
POSTGRES_USER=naryad
# Uzun tasodifiy parol: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Zaxira nusxa ---
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
