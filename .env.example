# Nusxa oling: cp .env.example .env  (Windows: copy .env.example .env)

# Ishlab chiqishda True, serverda (Railway) False
DJANGO_DEBUG=True

# Serverda albatta uzun tasodifiy qiymat qo'ying:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Vergul bilan ajratilgan domenlar
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS orqali ochiladigan manzillar (Railway: https://<loyiha>.up.railway.app)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Bo'sh bo'lsa — SQLite (db.sqlite3). PostgreSQL namunasi:
# DATABASE_URL=postgres://naryad:naryad@localhost:5432/naryad
DATABASE_URL=

# Proksi orqasida HTTPS (Railway'da True)
DJANGO_SECURE_PROXY=False
